<% layout("/layouts/boilerplate.ejs") -%>
 
    <h2>Create a new note</h2>
    <form action="/notes" method="POST" novalidate class="needs-validation">
       <div>
            <label for="title" class="form-label">Title:</label>
            <input type="text" name="title" placeholder="maths" class="form-control" required>
            <div class="valid-feedback">Title looks good!</div>
        </div><br>
        <div>
            <label for="content" class="form-label">Content:</label>
            <textarea   name="content" class="form-control" placeholder="revision chapter 9" required></textarea>
            <div class="invalid-feedback">Please enter a short content</div>
        </div> <br>
    <button class="btn btn-primary" type="submit">Create a note</button>
    </form>
 
 